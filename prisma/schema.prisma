// Prisma schema for AutoSocial - production-ready social media automation agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  caption        String?
  hashtags       String?
  filePath       String
  fileName       String
  fileSize       Int         @default(0)
  thumbnailPath  String?
  platform       String      @default("youtube")
  status         String      @default("PENDING")
  scheduledFor   DateTime?
  uploadedAt     DateTime?
  platformPostId String?
  aiGenerated    Boolean     @default(false)
  duration       Int? // in seconds
  activityLogs   ActivityLog[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model Platform {
  id                  String   @id @default(cuid())
  name                String   @unique
  displayName         String
  enabled             Boolean  @default(false)
  connected           Boolean  @default(false)
  icon                String?
  color               String?
  // OAuth / API credentials (stored locally; encrypt in production)
  accessToken         String?
  refreshToken        String?
  apiKey              String?
  apiSecret           String?
  // Account info returned by the platform on validation
  connectedAccountId  String?
  connectedAccountName String?
  connectedAccountAvatar String?
  connectedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
